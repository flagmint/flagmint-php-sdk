{
  "name": "flagmint/php-sdk",
  "description": "Flagmint PHP SDK — local evaluation with REST config-sync",
  "type": "library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Flagmint",
      "homepage": "https://flagmint.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-sodium": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0|^2.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.8",
    "phpunit/phpunit": "^10.5",
    "predis/predis": "^2.2"
  },
  "suggest": {
    "predis/predis": "Required to use Flagmint\\Cache\\RedisAdapter",
    "guzzlehttp/guzzle": "Convenient PSR-18 HTTP client for production use"
  },
  "autoload": {
    "psr-4": {
      "Flagmint\\": "src/"
    },
    "files": [
      "src/Support/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Flagmint\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
